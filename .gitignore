# Python
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/
build/
dist/

# Editors and operating systems
.idea/
.vscode/*.log
.DS_Store
Thumbs.db

# Local configuration
.env
*.local.toml

# Generated research artifacts
artifacts/
outputs/
data/processed/
notebooks/.ipynb_checkpoints/

# LaTeX build intermediates and local visual-QA renders.
paper/*.aux
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/**/*.qa.png
paper/build/
paper/figures/*.qa.png
paper/figures/qa*/
paper/figures/submission_qa*/

# Literature PDFs are downloaded locally from the tracked manifest.
# Keeping them out of the public repository avoids accidental redistribution.
literature/papers/*.pdf
literature/papers/*.part
!literature/papers/.gitkeep

# Shared ECG data live in ../PUBLIC and must never be copied into this repository.
PUBLIC/
data/raw/
*.dat
*.hea
*.ecg
*.atr
*.qrs
*.ann
*.mat
*.h5
*.hdf5
*.npz
*.npy
